# Finance Analyzer - Environment Variables
# Copy this file to .env and fill in your values.

# Required: OpenAI API key for the LLM agent.
OPENAI_API_KEY=sk-your-key-here

# Optional: Override OpenAI API endpoint for OpenAI-compatible providers.
# Leave unset to use the default OpenAI API.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Required: Your Firefly III instance URL and personal access token.
FIREFLY_BASE_URL=https://your-firefly-instance.com/api
FIREFLY_API_TOKEN=your-firefly-token-here